main.py

from flask import Flask, render_template, request, send_file
from datetime import datetime
import qrcode
from barcode import Code128
from barcode.writer import ImageWriter
from io import BytesIO
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib.pagesizes import letter
import base64
import os

app = Flask(__name__)

# Ensure folders
os.makedirs("generated", exist_ok=True)

@app.route('/')
def index():
    return render_template('form.html')

@app.route('/generate', methods=['POST'])
def generate():
    data = request.form.to_dict()

    # Convert numeric fields
    hourly = float(data.get('hourly_rate', 0))
    hours = float(data.get('hours_worked', 0))
    ytd_prev = float(data.get('ytd_previous', 0))

    gross = hourly * hours
    ytd_total = ytd_prev + gross

    data['gross_pay'] = f"{gross:.2f}"
    data['ytd_total'] = f"{ytd_total:.2f}"

    # === QR CODE ===
    qr_img_io = BytesIO()
    qr = qrcode.make(f"Paystub for {data.get('employee_name')}")
    qr.save(qr_img_io, format='PNG')
    qr_img_io.seek(0)
    qr_b64 = base64.b64encode(qr_img_io.read()).decode()

    # === BARCODE ===
    barcode_io = BytesIO()
    code = Code128(data.get('employee_id', '0000'), writer=ImageWriter())
    code.write(barcode_io)
    barcode_io.seek(0)
    barcode_b64 = base64.b64encode(barcode_io.read()).decode()

    return render_template('paystub.html', data=data, qr=qr_b64, barcode=barcode_b64)

# PDF generation
@app.route('/pdf', methods=['POST'])
def pdf():
    data = request.form.to_dict()
    pdf_path = f"generated/paystub_{datetime.now().timestamp()}.pdf"

    styles = getSampleStyleSheet()
    doc = SimpleDocTemplate(pdf_path, pagesize=letter)
    elements = []

    for key, value in data.items():
        elements.append(Paragraph(f"<b>{key.replace('_', ' ').title()}:</b> {value}", styles['Normal']))
        elements.append(Spacer(1, 12))

    doc.build(elements)

    return send_file(pdf_path, as_attachment=True)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)


